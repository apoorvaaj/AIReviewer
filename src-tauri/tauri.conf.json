{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IB Feedback Coach",
  "version": "0.1.0",
  "identifier": "org.ibfeedbackcoach.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../knowledge-base/": "knowledge-base/",
      "../validator-rules.yaml": "validator-rules.yaml"
    }
  }
}
